<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0
          https://maven.apache.org/xsd/assembly-2.2.0.xsd">

    <id>fat-tests</id>

    <formats>
        <format>jar</format>
    </formats>

    <includeBaseDirectory>false</includeBaseDirectory>

    <!--
        Unpacks compile- and test-scope dependency JARs into the JAR root.

        Artifact-level exclusions (never needed for remote Selenium execution):
          - selenium-devtools-v*  : Chrome DevTools Protocol bindings. CDP requires
                                   a local browser process. RemoteWebDriver uses the
                                   W3C WebDriver protocol only — CDP is never invoked.
          - webdrivermanager      : Auto-resolves local driver binaries. DriverFactory
                                   only calls WebDriverManager inside createLocalDriver(),
                                   which is never reached when execution.mode=remote.
          - docker-java (all)     : WebDriverManager's Docker integration for spinning
                                   up containerised browsers. Never used.
          - bouncycastle (all)    : TLS crypto pulled in by docker-java. Never used.
          - jna                   : Java Native Access pulled in by docker-java. Never used.
          - brotli                : Brotli decompression for WebDriverManager HTTP. Never used.
          - lombok                : Compile-time annotation processor pulled in by
                                   ExtentReports. Generated bytecode is already in
                                   ExtentReports' compiled classes — Lombok itself is
                                   inert at runtime.

        File-level exclusions (unpackOptions):
          - *.SF / *.DSA / *.RSA : JAR signing metadata. Merging signed JARs without
                                   stripping these causes SecurityException at class load.
          - MANIFEST.MF          : Each JAR has its own; the assembly plugin writes a
                                   clean merged manifest.
          - *.crx                : Chrome extension binaries bundled by WebDriverManager.
                                   Never loaded in remote execution.
          - *.SCL.lombok         : Lombok's internal bytecode patching files. Inert.
    -->
    <dependencySets>
        <dependencySet>
            <outputDirectory>/</outputDirectory>
            <useProjectArtifact>false</useProjectArtifact>
            <unpack>true</unpack>
            <scope>test</scope>
            <excludes>
                <!-- Selenium DevTools Protocol — unused with RemoteWebDriver -->
                <exclude>org.seleniumhq.selenium:selenium-devtools-v85</exclude>
                <exclude>org.seleniumhq.selenium:selenium-devtools-v120</exclude>
                <exclude>org.seleniumhq.selenium:selenium-devtools-v121</exclude>
                <exclude>org.seleniumhq.selenium:selenium-devtools-v122</exclude>
                <!-- WebDriverManager and its entire dependency subtree -->
                <exclude>io.github.bonigarcia:webdrivermanager</exclude>
                <exclude>com.github.docker-java:docker-java</exclude>
                <exclude>com.github.docker-java:docker-java-core</exclude>
                <exclude>com.github.docker-java:docker-java-api</exclude>
                <exclude>com.github.docker-java:docker-java-transport</exclude>
                <exclude>com.github.docker-java:docker-java-transport-httpclient5</exclude>
                <exclude>org.bouncycastle:bcpkix-jdk18on</exclude>
                <exclude>org.bouncycastle:bcprov-jdk18on</exclude>
                <exclude>org.bouncycastle:bcutil-jdk18on</exclude>
                <exclude>net.java.dev.jna:jna</exclude>
                <exclude>org.brotli:dec</exclude>
                <!-- Compile-time annotation processor — inert at runtime -->
                <exclude>org.projectlombok:lombok</exclude>
            </excludes>
            <unpackOptions>
                <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <!-- Chrome extension binaries — unused in remote execution -->
                    <exclude>*.crx</exclude>
                    <!-- Lombok bytecode patching infrastructure — inert at runtime -->
                    <exclude>**/*.SCL.lombok</exclude>
                </excludes>
            </unpackOptions>
        </dependencySet>
    </dependencySets>

    <fileSets>
        <!-- Main compiled classes: com.framework.* -->
        <fileSet>
            <directory>${project.build.outputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
        </fileSet>

        <!--
            Test compiled classes (com.intralox.*) and all test resources.
            local-secrets.properties is excluded — credentials must never be
            embedded in a distributable artifact.
        -->
        <fileSet>
            <directory>${project.build.testOutputDirectory}</directory>
            <outputDirectory>/</outputDirectory>
            <excludes>
                <exclude>local-secrets.properties</exclude>
            </excludes>
        </fileSet>
    </fileSets>

</assembly>
