# Local credential template — do not commit real credentials here.
#
# Setup:
#   1. Copy this file to the same directory and name it: local-secrets.properties
#   2. Replace the placeholder values with your actual credentials.
#   3. local-secrets.properties is gitignored and will never be committed.
#
# In CI/CD and BlazeMeter, set these as environment variables instead.

MYINTRALOX_EMAIL=your-email@example.com
MYINTRALOX_PASSWORD=your-password
