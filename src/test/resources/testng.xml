<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
    Default suite bundled with selenium-framework-core.
    Consumer projects should supply their own suite XML via:
        mvn test -Dtestng.suite.file=src/test/resources/your-suite.xml

    Thread count is overridden by Maven Surefire when thread.count is set
    (e.g. mvn test -Dthread.count=5).
-->
<suite name="Selenium Framework Core" parallel="methods" thread-count="3" verbose="1">

    <test name="Framework Validation">
        <packages>
            <package name="com.framework.validation"/>
        </packages>
    </test>

</suite>
